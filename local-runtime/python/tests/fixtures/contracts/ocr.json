{
  "inputs": [{
    "name": "zeile", "source": "image", "dataType": "float32", "shape": ["dynamic", 3, 48, "dynamic"],
    "transformations": [
      {"type": "image.crop", "parameters": {
        "left": "$iteration.value.bounds.left", "top": "$iteration.value.bounds.top",
        "width": "$iteration.value.bounds.width", "height": "$iteration.value.bounds.height"}},
      {"type": "image.resizeHeightPad", "parameters": {"height": 48, "widthMultiple": 8, "colorSpace": "rgb"}},
      {"type": "tensor.scale", "parameters": {"factor": 0.00784313725, "offset": -1}},
      {"type": "tensor.layout", "parameters": {"order": "channelsFirst"}}
    ]
  }],
  "outputs": [
    {"name": "maske", "dataType": "float32", "shape": ["dynamic", 1, "dynamic", "dynamic"], "transformations": [
      {"type": "mask.textRegions", "result": "detectedRegions", "parameters": {"threshold": 0.3, "minimumPixels": 8, "minimumScore": 0.5}},
      {"type": "geometry.mergeRows", "result": "regions", "parameters": {"minimumVerticalOverlap": 0.5}},
      {"type": "geometry.scaleBounds", "parameters": {"scaleX": 4, "scaleY": 4}}
    ]},
    {"name": "logits", "dataType": "float32", "shape": ["dynamic", "dynamic", 4], "transformations": [
      {"type": "sequence.ctcGreedyDecode", "parameters": {"labels": ["", "a", "b", "c"], "blankIndex": 0, "allowedCharacters": "ab"}}
    ]}
  ]
}
