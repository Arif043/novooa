{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "genkit:start": "genkit start -- tsx --watch src/task-workflows.ts",
    "genkit:proxy": "tsx src/local-dev/genkit-cors-proxy.ts"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/compat-oai": "^1.39.0",
    "@genkit-ai/firebase": "^1.37.0",
    "@genkit-ai/google-genai": "^1.37.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "genkit": "^1.37.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "private": true
}
