{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test lib/shared/local/*.test.js lib/features/assistant/domain/usecases/*.test.js lib/features/assistant/infrastructure/genkit/*.test.js lib/features/notifications/infrastructure/firebase/*.test.js lib/features/communication/domain/usecases/*.test.js lib/features/knowledge_base/infrastructure/genkit/*.test.js lib/features/knowledge_base/infrastructure/local/*.test.js lib/features/language_models/infrastructure/genkit/*.test.js lib/features/language_models/infrastructure/local/*.test.js lib/features/machine_learning/domain/entities/*.test.js lib/features/machine_learning/domain/usecases/*.test.js lib/features/machine_learning/infrastructure/*.test.js lib/features/machine_learning/infrastructure/cli/*.test.js lib/features/machine_learning/infrastructure/cloud_run/*.test.js lib/features/machine_learning/infrastructure/firebase/*.test.js lib/features/machine_learning/infrastructure/local/*.test.js lib/features/teams/infrastructure/local/*.test.js lib/features/task_execution/domain/usecases/*.test.js lib/features/task_execution/infrastructure/firebase/*.test.js lib/features/task_execution/infrastructure/genkit/*.test.js lib/features/task_execution/infrastructure/genkit/assistant/*.test.js lib/features/task_execution/infrastructure/genkit/executors/*.test.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx -y firebase-tools@latest emulators:start",
    "shell": "npm run build && npx -y firebase-tools@latest functions:shell",
    "start": "npm run shell",
    "deploy": "npx -y firebase-tools@latest deploy --only functions",
    "logs": "npx -y firebase-tools@latest functions:log",
    "schedule:run:local": "curl -i -X POST -H \"X-CloudScheduler: true\" http://127.0.0.1:5001/syscat-90bff/europe-west3/runDueTaskTriggersWorker-0",
    "schedule:watch:local": "while true; do npm run schedule:run:local; sleep 60; done",
    "models:publish": "npm run build && node lib/features/machine_learning/infrastructure/cli/model-publish-cli.js",
    "models:install-local": "npm run build && node lib/features/machine_learning/infrastructure/cli/local-model-install-cli.js"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/compat-oai": "^1.39.0",
    "@genkit-ai/firebase": "^1.37.0",
    "@genkit-ai/google-genai": "^1.37.0",
    "@genkit-ai/middleware": "^0.7.0",
    "cheerio": "^1.2.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "genkit": "^1.37.0",
    "google-auth-library": "^10.9.1",
    "twilio": "^6.0.2",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.3"
  },
  "private": true
}
