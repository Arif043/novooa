FROM python:3.12-slim

WORKDIR /app

# Nur die Standardbibliothek: gemeinsamer Bündelcode und der Cache-Dienst, nichts vom ML-Dienst.
COPY local-runtime/python/novooa_bundles /app/python/novooa_bundles
COPY local-runtime/python/novooa_model_cache /app/python/novooa_model_cache

RUN mkdir -p /var/lib/novooa-model-cache && chown -R 65532:65532 /var/lib/novooa-model-cache

ENV PORT=8082 \
  PYTHONPATH=/app/python \
  MODEL_CACHE_DIR=/var/lib/novooa-model-cache

USER 65532

CMD ["python", "-m", "novooa_model_cache.server"]
