FROM node:24-bookworm-slim AS build

WORKDIR /app/functions

COPY functions/package.json functions/package-lock.json ./
RUN npm ci

COPY functions/tsconfig.json ./
COPY functions/src ./src
RUN npm run build

# Härtung: Node-Entrypoint gebündelt + obfuskiert (siehe
# functions/scripts/harden-node.mjs).
COPY functions/scripts ./scripts
RUN npm run harden:node

# Härtungs-Stage für Python: Module mit Nuitka zu nativen .so kompilieren.
# Bewusst dieselbe Basis (bookworm python3) wie die Runtime-Stage, damit die
# .so ABI-kompatibel zur ausführenden Python-Version sind.
FROM node:24-bookworm-slim AS harden-py

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip python3-dev build-essential \
  && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages nuitka

WORKDIR /src
COPY local-runtime/python ./
RUN rm -rf tests && python3 harden_python.py /src && rm -f harden_python.py

FROM node:24-bookworm-slim AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip \
  && rm -rf /var/lib/apt/lists/*

COPY local-runtime/python/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --break-system-packages -r /tmp/requirements.txt

WORKDIR /app/functions
COPY --from=build /app/functions/package.json /app/functions/package-lock.json ./
COPY --from=build /app/functions/node_modules ./node_modules
# Nur das gehärtete Bündel statt des lesbaren lib/-Baums (CMD-Pfad bleibt gleich).
COPY --from=build /app/functions/dist-protected ./lib
# Nur die gehärteten Python-Module (native .so + Launcher) statt des Quelltexts.
# Die von Node per Pfad gestarteten Worker bleiben am selben Pfad (Launcher).
COPY --from=harden-py /src /app/local-runtime/python

ENV NODE_ENV=production \
  PYTHON_EXECUTABLE=python3 \
  INPUT_TRANSFORM_WORKER_PATH=/app/local-runtime/python/input_transform_worker.py \
  ONNX_WORKER_PATH=/app/local-runtime/python/onnx_worker.py

USER node

CMD ["node", "lib/features/machine_learning/infrastructure/model-inference-service.js"]
