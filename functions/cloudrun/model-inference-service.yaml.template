apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: novooa-model-inference
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/maxScale: "10"
        autoscaling.knative.dev/minScale: "1"
        run.googleapis.com/container-dependencies: '{"gateway":["inference-sidecar"]}'
    spec:
      containerConcurrency: 1
      containers:
        - name: gateway
          image: NODE_IMAGE
          ports:
            - containerPort: 8080
          env:
            - name: PYTHON_INFERENCE_SIDECAR_URL
              value: http://127.0.0.1:8081
          resources:
            limits:
              cpu: "1"
              memory: 512Mi
        - name: inference-sidecar
          image: SIDECAR_IMAGE
          env:
            # Ein Sidecar pro Pod, nur für das Gateway daneben: keine Mandanten, keine Anmeldung.
            - name: ML_TENANCY
              value: "off"
            # Globaler Modellspeicher (öffentlich lesbar). Der Sidecar lädt Modelle selbst und hält sie in /tmp,
            # das in Cloud Run im Arbeitsspeicher liegt — daher die Grenzen unten.
            - name: MODEL_STORE_URL
              value: MODEL_STORE_URL
            - name: ML_DATA_DIR
              value: /tmp/novooa-ml
            - name: MODEL_BUNDLE_MAX_BYTES
              value: "536870912"
            - name: MODEL_SESSION_CACHE_BYTES
              value: "1073741824"
          resources:
            limits:
              cpu: "1"
              memory: 2Gi
