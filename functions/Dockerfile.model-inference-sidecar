FROM python:3.12-slim

WORKDIR /app

COPY local-runtime/python/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt

COPY local-runtime/python /app/python

ENV PORT=8081 \
  PYTHONPATH=/app/python \
  MODEL_SESSION_CACHE_ENTRIES=4

USER 65532

CMD ["python", "-m", "novooa_ml.inference_server"]
