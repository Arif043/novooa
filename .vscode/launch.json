{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "novooa (macOS)",
            "request": "launch",
            "type": "dart",
            "deviceId": "macos"
        },
        {
            // Der Dev-Server ist nicht die Runtime: Die Adresse kommt per
            // Define, und die Runtime muss http://localhost:5050 per
            // LOCAL_RUNTIME_ALLOWED_ORIGINS zulassen.
            "name": "novooa (Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--web-port=5050",
                "--dart-define=WORKSPACE_API_URL=http://127.0.0.1:8090"
            ]
        },
        {
            // Oberfläche ohne Runtime und Lizenz; Daten nur im
            // Speicher (docs/notes/ui-vorschau.md).
            "name": "novooa UI-Vorschau (Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "program": "lib/main_preview.dart"
        },
        {
            "name": "novooa UI-Vorschau (macOS)",
            "request": "launch",
            "type": "dart",
            "deviceId": "macos",
            "program": "lib/main_preview.dart"
        },
        {
            "name": "syscat2 (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
