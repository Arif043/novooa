        "source": "image",
        "dataType": "float32",
        "shape": [
          "dynamic",
          3,
          "dynamic",
          "dynamic"
        ],
        "transformations": [
          {
            "type": "image.decode",
            "parameters": {
              "colorSpace": "rgb"
            }
          },
          {
            "type": "image.crop",
            "parameters": {
              "left": "$iteration.value.bounds.left",
              "top": "$iteration.value.bounds.top",
              "width": "$iteration.value.bounds.width",
              "height": "$iteration.value.bounds.height"
            }
          },
          {
            "type": "image.resizePad",
            "parameters": {
              "width": 320,
              "height": 48,
              "alignment": "topLeft",
              "background": 0
            }
          },
          {
            "type": "tensor.channelOrder",
            "parameters": {
              "order": [
                2,
                1,
                0
              ]
            }
          },
          {
            "type": "tensor.layout",
            "parameters": {
              "order": "channelsFirst"
            }
          },
          {
            "type": "tensor.normalize",
            "parameters": {
              "mean": [
                127.5,
                127.5,
                127.5
              ],
              "std": [
                127.5,
                127.5,
                127.5
              ]
            }
          }
        ]
      }
    ],
