{
  "id": "pp-ocr-v6-text-detector-small",
  "title": "PP-OCRv6 Small Texterkennung",
  "description": "Erkennt Textregionen in Dokumenten und Belegen.",
  "task": "optical-character-recognition",
  "languages": [],
  "tags": [
    "invoices",
    "receipts",
    "lightweight"
  ],
  "artifact": {
    "artifactId": "pp-ocr-v6-text-detector-small",
    "versionId": "rapidocr-3.9.2"
  },
  "contract": {
    "inputs": [
      {
        "name": "x",
        "source": "image",
        "dataType": "float32",
        "shape": [
          "dynamic",
          3,
          "dynamic",
          "dynamic"
        ],
        "transformations": [
          {
            "type": "image.decode",
            "parameters": {
              "colorSpace": "rgb"
            }
          },
          {
            "type": "image.resizeWithin",
            "parameters": {
              "minSide": 736,
              "maxSide": 2000
            }
          },
          {
            "type": "image.padToMultiple",
            "parameters": {
              "multiple": 32,
              "background": 0
            }
          },
          {
            "type": "tensor.channelOrder",
            "parameters": {
              "order": [
                2,
                1,
                0
              ]
            }
          },
          {
            "type": "tensor.layout",
            "parameters": {
              "order": "channelsFirst"
            }
          },
          {
            "type": "tensor.normalize",
            "parameters": {
              "mean": [
                127.5,
                127.5,
                127.5
              ],
              "std": [
                127.5,
                127.5,
                127.5
              ]
            }
          }
        ]
      }
    ],
    "outputs": [
      {
        "name": "fetch_name_0",
        "semantic": "textDetection.probabilityMask",
        "dataType": "float32",
        "shape": [
          "dynamic",
          1,
          "dynamic",
          "dynamic"
        ],
        "transformations": [
          {
            "type": "mask.textRegions",
            "parameters": {
              "threshold": 0.3,
              "minimumPixels": 8,
              "minimumScore": 0.5,
              "dilationWidth": 2,
              "dilationHeight": 2,
              "unclipRatio": 1.6
            },
            "result": "detectedRegions"
          },
          {
            "type": "geometry.mergeRows",
            "parameters": {
              "minimumVerticalOverlap": 0.5
            },
            "result": "regions"
          },
          {
            "type": "geometry.toSource",
            "parameters": {
              "input": "x"
            }
          }
        ],
        "workflowOutput": {
          "name": "regions",
          "type": "json",
          "mapping": "$regions"
        }
      }
    ]
  }
}
