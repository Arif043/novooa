{
  "id": "pp-ocr-v6-text-detector-small",
  "title": "PP-OCRv6 Small Texterkennung",
  "description": "Erkennt Textregionen in Dokumenten und Belegen.",
  "tags": [
    "ocr",
    "text",
    "dokument",
    "beleg",
    "rechnung",
    "small"
  ],
  "artifact": {
    "artifactId": "pp-ocr-v6-text-detector-small",
    "versionId": "rapidocr-3.9.2"
  },
  "contract": {
    "inputs": [
      {
        "name": "x",
        "source": "image",
        "dataType": "float32",
        "shape": [
          "dynamic",
          3,
          "dynamic",
          "dynamic"
        ],
        "transformations": [
          {
            "type": "image.decode",
            "parameters": {
              "colorSpace": "rgb"
            }
          },
          {
            "type": "image.padToMultiple",
            "parameters": {
              "multiple": 32,
              "background": 0
            }
          },
          {
            "type": "tensor.channelOrder",
            "parameters": {
              "order": [
                2,
                1,
                0
              ]
            }
          },
          {
            "type": "tensor.layout",
            "parameters": {
              "order": "channelsFirst"
            }
          },
          {
            "type": "tensor.normalize",
            "parameters": {
              "mean": [
                123.675,
                116.28,
                103.53
              ],
              "std": [
                58.395,
                57.12,
                57.375
              ]
            }
          }
        ]
      }
    ],
    "outputs": [
      {
        "name": "fetch_name_0",
        "semantic": "textDetection.probabilityMask",
        "dataType": "float32",
        "shape": [
          "dynamic",
          1,
          "dynamic",
          "dynamic"
        ],
        "transformations": [
          {
            "type": "mask.textRegions",
            "parameters": {
              "threshold": 0.3,
              "minimumPixels": 8,
              "minimumScore": 0.5,
              "dilationWidth": 3,
              "dilationHeight": 1,
              "padding": 1
            },
            "result": "detectedRegions"
          },
          {
            "type": "geometry.mergeRows",
            "parameters": {
              "minimumVerticalOverlap": 0.5
            },
            "result": "regions"
          }
        ],
        "workflowOutput": {
          "name": "regions",
          "type": "json",
          "mapping": "$regions"
        }
      }
    ]
  }
}
