rules_version = '2';

// Firestore dient nur noch den Hintergrunddiensten der Runtime (Lizenz,
// Relays, Postfächer). Die Functions schreiben über das Admin SDK und sind
// von diesen Regeln nicht betroffen. Clients sind ausschließlich Runtimes,
// angemeldet als technischer Firebase-Nutzer mit den Claims `localRuntime`
// und `runtimeLicenseId` (siehe `docs/notes/runtime-firebase-wakeup.md`).
service cloud.firestore {
  match /databases/{database}/documents {
    function isLocalRuntime() {
      return request.auth != null && request.auth.token.localRuntime == true;
    }

    function isLocalRuntimeForLicense(licenseId) {
      return isLocalRuntime() && request.auth.token.runtimeLicenseId == licenseId;
    }

    // Enthält nur Revisionsnummern, nie Nachrichteninhalte.
    match /localRuntimeWakeups/{licenseId} {
      allow get: if isLocalRuntimeForLicense(licenseId);
      allow list, create, update, delete: if false;
    }

    // Kuratierte Modell-Metadaten; die Artefakte lädt die Runtime direkt
    // von ihrer angegebenen Quelle.
    match /modelCatalog/{modelId} {
      allow get, list: if isLocalRuntime();
      allow write: if false;
    }

    // Kontrolliertes Tag-Vokabular der Modelle; pflegt nur der Betreiber (models:tags:publish).
    match /modelTags/{tagKey} {
      allow get, list: if isLocalRuntime();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
